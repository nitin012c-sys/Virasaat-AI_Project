<!doctype html>
<html lang="<!-- figma:lang -->">
  <head>
    <!-- figma:head-start -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VIRASAAT — India’s Living Digital Archive<!-- figma:title --></title>
    <!-- figma:head-end -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <style>
      :root {
        font-family: "DM Sans", sans-serif;
        color: #2b2118;
        background: #efe9dc;
        font-synthesis: none;
        --paper: #f4efe4;
        --ink: #2b2118;
        --brick: #a94225;
        --gold: #c79645;
        --olive: #5c633f;
        --line: rgba(43, 33, 24, 0.2);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; min-width: 320px; background: var(--paper); }
      button, a { font: inherit; }
      button { color: inherit; }
      a { color: inherit; text-decoration: none; }
      img { display: block; width: 100%; }

      .site-shell {
        min-height: 100vh;
        overflow: hidden;
        background-color: var(--paper);
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.035'/%3E%3C/svg%3E");
      }

      .topbar {
        height: 84px;
        max-width: 1440px;
        margin: auto;
        padding: 0 5vw;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        font-family: "Playfair Display", serif;
        font-weight: 700;
        letter-spacing: .14em;
        font-size: 18px;
        color: inherit;
      }
      .brand-mark { color: var(--brick); display: flex; align-items: center; }
      .desktop-nav { display: flex; gap: 36px; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
      .desktop-nav a { transition: color .2s ease; }
      .desktop-nav a:hover { color: var(--brick); }
      
      .nav-action, .primary-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        border: 1px solid var(--ink);
        min-height: 46px;
        padding: 0 20px;
        background: var(--ink);
        color: var(--paper);
        text-transform: uppercase;
        letter-spacing: .08em;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s ease, color .2s ease, transform .2s ease;
      }
      .nav-action:hover, .primary-action:hover {
        background: var(--brick);
        transform: translateY(-2px);
      }

      .hero {
        min-height: 720px;
        max-width: 1440px;
        margin: auto;
        padding: 70px 7vw 90px;
        display: grid;
        grid-template-columns: .9fr 1.1fr;
        align-items: center;
        gap: 6vw;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 28px;
        color: var(--brick);
        text-transform: uppercase;
        letter-spacing: .16em;
        font-size: 11px;
        font-weight: 600;
      }
      .eyebrow span { width: 34px; height: 1px; background: currentColor; }
      
      .hero h1, .section-heading h2, .archive-title h2 {
        margin: 0;
        font-family: "Playfair Display", serif;
        font-size: clamp(62px, 7.3vw, 112px);
        line-height: .86;
        letter-spacing: -.055em;
        font-weight: 600;
      }
      h1 em, h2 em { color: var(--brick); font-style: italic; font-weight: 600; }
      .hero-intro {
        max-width: 500px;
        margin: 38px 0 32px;
        color: #65594d;
        font-family: "Playfair Display", serif;
        font-size: 19px;
        line-height: 1.65;
      }
      .hero-actions { display: flex; align-items: center; gap: 24px; }
      .archive-note {
        border-left: 1px solid var(--line);
        padding-left: 22px;
        color: #807468;
        font-size: 10px;
        line-height: 1.6;
        text-transform: uppercase;
        letter-spacing: .13em;
      }

      .hero-collage { position: relative; height: 580px; }
      .sun-disc {
        position: absolute;
        width: 350px;
        height: 350px;
        border-radius: 50%;
        background: #d7a64e;
        opacity: .72;
        top: 20px;
        left: 7%;
      }
      .photo-main {
        position: absolute;
        width: 62%;
        height: 485px;
        top: 35px;
        right: 8%;
        margin: 0;
        border: 10px solid #e8dfcf;
        box-shadow: 0 25px 50px rgba(43,33,24,.2);
        transform: rotate(2.5deg);
      }
      .photo-main img, .photo-small img {
        height: 100%;
        object-fit: cover;
        filter: sepia(.55) saturate(.76) contrast(1.08);
      }
      .photo-main figcaption {
        position: absolute;
        left: -55px;
        bottom: -47px;
        background: var(--paper);
        padding: 13px 18px;
        font-family: "Playfair Display", serif;
        font-size: 14px;
        box-shadow: 0 10px 30px rgba(43,33,24,.12);
        transform: rotate(-2.5deg);
      }
      .photo-main figcaption span {
        color: #8c7b6a;
        font-family: "DM Sans", sans-serif;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: .12em;
      }
      .photo-small {
        position: absolute;
        width: 33%;
        height: 190px;
        margin: 0;
        left: 0;
        bottom: 20px;
        border: 7px solid #e8dfcf;
        transform: rotate(-6deg);
        box-shadow: 0 16px 35px rgba(43,33,24,.2);
        z-index: 2;
      }
      .vertical-type {
        position: absolute;
        right: -18px;
        top: 128px;
        writing-mode: vertical-rl;
        color: #817262;
        font-size: 9px;
        letter-spacing: .28em;
      }
      .stamp {
        position: absolute;
        right: 0;
        bottom: 10px;
        width: 84px;
        height: 84px;
        border: 1px solid var(--brick);
        border-radius: 50%;
        color: var(--brick);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 8px;
        letter-spacing: .18em;
        transform: rotate(8deg);
      }
      .stamp strong { font-family: "Playfair Display", serif; font-size: 18px; letter-spacing: 0; }

      .marquee {
        background: var(--brick);
        color: #f3e7d4;
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3.6vw;
        text-transform: uppercase;
        letter-spacing: .16em;
        font-size: 11px;
        white-space: nowrap;
      }
      .marquee i { color: #e1b763; font-style: normal; }

      .feature-section { max-width: 1440px; margin: auto; padding: 120px 7vw; }
      .section-heading {
        display: grid;
        grid-template-columns: 1.3fr .7fr;
        align-items: end;
        gap: 50px;
        margin-bottom: 70px;
      }
      .section-heading h2 { font-size: clamp(50px, 6vw, 86px); }
      .section-heading > p {
        max-width: 430px;
        margin: 0 0 8px;
        color: #776b5f;
        font-family: "Playfair Display", serif;
        line-height: 1.7;
      }
      .feature-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .feature-card {
        position: relative;
        min-height: 365px;
        border: 0;
        border-right: 1px solid var(--line);
        padding: 30px 24px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        background: transparent;
        cursor: pointer;
        transition: background .25s ease, transform .25s ease;
      }
      .feature-card:last-child { border-right: 0; }
      .feature-card:hover, .feature-card.is-active { background: #e7ddcb; transform: translateY(-8px); }
      .feature-card.is-active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 4px;
        background: var(--brick);
      }
      .feature-number { color: #9b8b78; font-family: "Playfair Display", serif; font-size: 12px; }
      .feature-icon { margin: 36px 0 27px; color: var(--brick); display: flex; }
      .feature-card strong { font-family: "Playfair Display", serif; font-size: 21px; }
      .feature-card small {
        margin-top: 5px;
        color: var(--brick);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .11em;
      }
      .feature-description { margin-top: 22px; color: #786b5e; font-size: 12px; line-height: 1.65; }
      .feature-link {
        margin-top: auto;
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .1em;
      }

      .experience-section {
        position: relative;
        min-height: 100vh;
        background: #201a15;
        color: #f0e8db;
        scroll-margin-top: 0;
        overflow: hidden;
      }
      .experience-visual { position: absolute; inset: 0; overflow: hidden; }
      .experience-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(25,20,16,.94), rgba(31,25,20,.76) 55%, rgba(25,20,16,.9)),
                    linear-gradient(0deg, rgba(24,19,15,.68), transparent 45%, rgba(24,19,15,.48));
        pointer-events: none;
      }
      .experience-visual > img {
        height: 100%;
        object-fit: cover;
        opacity: .58;
        filter: sepia(.72) saturate(.6) contrast(1.1) brightness(.62);
        transition: opacity .65s ease, transform .65s ease;
      }
      .experience-visual > img.animate-in {
        animation: backdrop-in .65s ease both;
      }
      @keyframes backdrop-in {
        from { opacity: 0; transform: scale(1.035); }
        to { opacity: .58; transform: scale(1); }
      }
      .experience-copy {
        width: min(1180px, 100%);
        min-height: 100vh;
        margin: auto;
        padding: 90px 5vw 80px;
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .experience-copy .eyebrow { color: #d4a653; margin-bottom: 12px; }
      .experience-count { color: #a49686; font-family: "Playfair Display", serif; font-size: 12px; letter-spacing: .1em; }
      .experience-copy h2 {
        margin: 16px 0;
        font-family: "Playfair Display", serif;
        font-size: clamp(50px, 6vw, 86px);
        line-height: .95;
      }
      .experience-lead { max-width: 720px; margin-bottom: 30px; color: #c9bdad; line-height: 1.75; font-size: 14px; }
      
      .model-overlay { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
      .model-badge {
        position: absolute;
        right: 4vw;
        bottom: 35px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: rgba(24,20,16,.75);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .1em;
        border: 1px solid rgba(240,232,219,.15);
      }
      .model-badge svg { color: #d7b36c; }

      .model-controls { display: flex; gap: 8px; margin: 16px 0 25px; flex-wrap: wrap; }
      .model-controls button, .state-picker button {
        border: 1px solid rgba(240,232,219,.25);
        background: transparent;
        color: inherit;
        padding: 10px 13px;
        cursor: pointer;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .08em;
        transition: background .2s ease, color .2s ease;
      }
      .model-controls button:hover, .state-picker button:hover, .state-picker button.selected {
        background: #f0e8db;
        color: #2c251d;
      }

      .story-player {
        width: 100%;
        border: 1px solid rgba(240,232,219,.2);
        background: rgba(255,255,255,.04);
        color: inherit;
        padding: 14px;
        margin: 14px 0 9px;
        display: flex;
        align-items: center;
        gap: 14px;
        text-align: left;
        cursor: pointer;
        transition: background .2s ease, border-color .2s ease;
      }
      .story-player:hover {
        background: rgba(255,255,255,.07);
        border-color: rgba(215,179,108,.5);
      }
      .play-button {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--brick);
        flex-shrink: 0;
      }
      .story-player small { display: block; color: #aa9d8c; text-transform: uppercase; font-size: 8px; letter-spacing: .12em; }
      .story-player strong { font-family: "Playfair Display", serif; font-size: 15px; }
      .soundwave { display: flex; align-items: center; gap: 3px; height: 30px; margin-left: auto; }
      .soundwave i { display: block; width: 2px; height: 8px; background: #d3b372; }
      .soundwave i:nth-child(2), .soundwave i:nth-child(4) { height: 19px; }
      .soundwave i:nth-child(3) { height: 27px; }
      .soundwave.moving i { animation: wave .7s ease-in-out infinite alternate; }
      .soundwave.moving i:nth-child(2) { animation-delay: -.35s; }
      .soundwave.moving i:nth-child(4) { animation-delay: -.2s; }
      @keyframes wave { to { transform: scaleY(.35); } }

      .browse-panel { max-width: 920px; margin-bottom: 4px; }
      .search-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
      .search-field {
        min-height: 50px;
        padding: 0 15px;
        display: flex;
        align-items: center;
        gap: 11px;
        border: 1px solid rgba(240,232,219,.28);
        background: rgba(255,255,255,.05);
        color: #d5c6af;
      }
      .search-field:focus-within { border-color: #d7b36c; }
      .search-field input {
        width: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        color: #f0e8db;
        font-size: 12px;
      }
      .search-field input::placeholder { color: #908474; }
      .surprise-button {
        min-height: 50px;
        padding: 0 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #d7b36c;
        background: #d7b36c;
        color: #2c251d;
        cursor: pointer;
        font-size: 9px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .08em;
        white-space: nowrap;
        transition: background .2s ease;
      }
      .surprise-button:hover { background: #e7ca90; }
      .search-results {
        position: relative;
        z-index: 4;
        margin: 7px 0 14px;
        border: 1px solid rgba(240,232,219,.17);
        background: #352d24;
        max-height: 240px;
        overflow-y: auto;
      }
      .search-results button {
        width: 100%;
        min-height: 53px;
        padding: 9px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 0;
        border-bottom: 1px solid rgba(240,232,219,.12);
        background: transparent;
        color: inherit;
        text-align: left;
        cursor: pointer;
      }
      .search-results button:last-child { border-bottom: 0; }
      .search-results button:hover { background: rgba(255,255,255,.07); }
      .search-results button span { display: flex; flex-direction: column; gap: 4px; }
      .search-results button strong { font-family: "Playfair Display", serif; font-size: 13px; }
      .search-results button small { color: #9e927f; font-size: 8px; text-transform: uppercase; letter-spacing: .08em; }
      .empty-state { margin: 0; padding: 18px; color: #a89a87; font-size: 11px; }
      .story-summary { margin: 0 0 22px; color: #a99c89; font-family: "Playfair Display", serif; font-size: 11px; line-height: 1.5; }

      .state-picker { margin: 0 0 25px; }
      .state-picker > small { display: block; margin-bottom: 10px; color: #a99a87; text-transform: uppercase; letter-spacing: .12em; }
      .state-picker > div { display: flex; flex-wrap: wrap; gap: 8px; }
      .culture-browser { margin-bottom: 24px; }
      .culture-browser .state-picker { margin-bottom: 17px; }
      .culture-browser blockquote {
        margin: 0 0 19px;
        padding: 0 0 0 15px;
        border-left: 2px solid #d7b36c;
        color: #d5b877;
        font-family: "Playfair Display", serif;
        font-size: 15px;
        line-height: 1.45;
      }
      .collection-label, .change-gallery > small {
        display: block;
        margin: 0 0 10px;
        color: #998c7c;
        font-size: 8px;
        text-transform: uppercase;
        letter-spacing: .12em;
      }
      .culture-options { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      .culture-options button {
        min-height: 72px;
        padding: 11px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        border: 1px solid rgba(240,232,219,.17);
        background: rgba(255,255,255,.025);
        color: inherit;
        text-align: left;
        cursor: pointer;
        transition: border-color .2s ease, background .2s ease;
      }
      .culture-options button:hover, .culture-options button.selected {
        border-color: #d7b36c;
        background: rgba(215,179,108,.1);
      }
      .culture-options strong { font-family: "Playfair Display", serif; font-size: 12px; }
      .culture-options span { color: #998d7c; font-size: 8px; line-height: 1.4; }

      .recent-monuments { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
      .recent-monuments button {
        min-height: 68px;
        padding: 11px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        border: 1px solid rgba(240,232,219,.17);
        background: rgba(255,255,255,.025);
        color: inherit;
        text-align: left;
        cursor: pointer;
        transition: border-color .2s ease, background .2s ease;
      }
      .recent-monuments button:hover, .recent-monuments button.selected {
        border-color: #d7b36c;
        background: rgba(215,179,108,.1);
      }
      .recent-monuments strong { font-family: "Playfair Display", serif; font-size: 12px; }
      .recent-monuments span { color: #948878; font-size: 8px; }
      
      .visit-label { margin-top: 22px; }
      .visit-modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
      .visit-modes button {
        min-height: 96px;
        padding: 15px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid rgba(240,232,219,.2);
        background: rgba(30,24,19,.44);
        color: inherit;
        text-align: left;
        cursor: pointer;
        backdrop-filter: blur(5px);
        transition: border-color .2s ease, background .2s ease;
      }
      .visit-modes button:hover, .visit-modes button.selected {
        border-color: #d7b36c;
        background: rgba(215,179,108,.14);
      }
      .visit-modes button > svg { flex: 0 0 auto; color: #d7b36c; }
      .visit-modes button span { display: flex; flex-direction: column; gap: 7px; }
      .visit-modes button strong { font-family: "Playfair Display", serif; font-size: 13px; }
      .visit-modes button small { color: #9f9280; font-size: 8px; line-height: 1.45; }

      .change-gallery { margin-bottom: 22px; }
      .change-tabs { display: flex; gap: 7px; margin-bottom: 13px; flex-wrap: wrap; }
      .change-tabs button {
        padding: 8px 11px;
        border: 1px solid rgba(240,232,219,.2);
        background: transparent;
        color: #b4a795;
        cursor: pointer;
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: .07em;
        transition: all .2s ease;
      }
      .change-tabs button:hover, .change-tabs button.selected {
        border-color: #d7b36c;
        background: #d7b36c;
        color: #2c251d;
      }
      .then-now { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: 10px; }
      .then-now > div {
        min-height: 115px;
        padding: 17px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border: 1px solid rgba(240,232,219,.18);
        background: rgba(255,255,255,.04);
      }
      .then-now > div:last-child {
        border-color: rgba(215,179,108,.48);
        background: rgba(215,179,108,.09);
      }
      .then-now small { color: #a3937e; text-transform: uppercase; letter-spacing: .15em; font-size: 8px; }
      .then-now strong { margin: 7px 0; font-family: "Playfair Display", serif; font-size: 17px; }
      .then-now span { color: #8e8272; font-size: 8px; text-transform: uppercase; letter-spacing: .08em; }
      .then-now > i { display: flex; align-items: center; color: #d7b36c; font-style: normal; }
      .change-gallery > p { margin: 11px 0 0; color: #aa9d8a; font-family: "Playfair Display", serif; font-size: 11px; line-height: 1.5; }
      
      .scanner-button { border-color: #d7b36c; background: #d7b36c; color: #2c251d; margin-bottom: 25px; }
      .scanner-button:disabled { opacity: .75; transform: none; cursor: wait; }
      .scan-frame { position: absolute; inset: 15%; z-index: 3; pointer-events: none; }
      .corner { position: absolute; width: 45px; height: 45px; border-color: #f0d9a4; }
      .tl { left: 0; top: 0; border-left: 3px solid; border-top: 3px solid; }
      .tr { right: 0; top: 0; border-right: 3px solid; border-top: 3px solid; }
      .bl { left: 0; bottom: 0; border-left: 3px solid; border-bottom: 3px solid; }
      .br { right: 0; bottom: 0; border-right: 3px solid; border-bottom: 3px solid; }
      .scan-line {
        position: absolute;
        left: 2%;
        right: 2%;
        height: 2px;
        background: #e5b95e;
        box-shadow: 0 0 16px #e5b95e;
        animation: scan 1.7s ease-in-out infinite;
      }
      @keyframes scan { 0%,100% { top: 5%; } 50% { top: 94%; } }

      .scanner-result-card {
